{
  "name": "human-on-exception/laravel-example",
  "description": "Runnable Laravel reference slice for Human-on-Exception",
  "type": "project",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.40"
  },
  "require-dev": {
    "orchestra/testbench": "^10.8",
    "phpunit/phpunit": "^11.5 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
